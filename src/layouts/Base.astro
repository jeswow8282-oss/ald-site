---
// ── 검색 노출 스위치 ─────────────────────────────────────────────
// true  = 검색엔진에 노출하지 않음
// false = 정식 공개 (현재). public/robots.txt 와 함께 관리합니다.
const NOINDEX = false;

// ── 검색엔진 소유확인 코드 ───────────────────────────────────────
// 네이버 서치어드바이저 / 구글 서치콘솔에서 발급받은 값만 넣으면 됩니다.
// (HTML 태그 전체가 아니라 content="..." 안의 값만)
const NAVER_VERIFY = '';
const GOOGLE_VERIFY = '';
// ─────────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────────

const { frontmatter, title: titleProp, description: descProp, home, noindex, headings = [] } = Astro.props;
const toc = (headings ?? []).filter((h) => h.depth === 2);
const title = titleProp ?? frontmatter?.title ?? '부신백질이영양증 (ALD)';
const description =
  descProp ?? frontmatter?.description ??
  '부신백질이영양증(ALD)에 대한 한국어 정보. 대뇌형·부신척수신경병증·여성 ALD·부신기능부전·신생아 선별검사·식사요법.';
// base(하위 경로) 배포를 고려한 링크 처리
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p) => (p === '/' ? BASE + (L || '') + '/' : BASE + (L || '') + p);
const abs = (p) => (p === '/' ? BASE + '/' : BASE + p);

const rawPath = Astro.url.pathname.replace(/\/$/, '').replace(BASE, '') || '/';
const isEN = rawPath === '/en' || rawPath.startsWith('/en/');
const path = isEN ? (rawPath.replace(/^\/en/, '') || '/') : rawPath;
const L = isEN ? '/en' : '';

const NAV_KO = [
  { href: '/pathogenesis', label: 'ALD 개요' },
  { label: '표현형', children: [
      { href: '/cerebral-ald',          label: '대뇌형 (cALD)' },
      { href: '/amn',                   label: '부신척수신경병증 (AMN)' },
      { href: '/women',                 label: '여성 ALD' },
      { href: '/adrenal-insufficiency', label: '부신기능부전' },
    ] },
  { href: '/newborn-screening', label: '신생아 선별검사' },
  { label: '치료', children: [
      { href: '/treatment',                 label: '대뇌형 치료' },
      { href: '/amn#치료와-관리',             label: 'AMN 치료와 관리' },
      { href: '/adrenal-insufficiency#치료',  label: '부신기능부전 관리' },
    ] },
  { href: '/diet', label: '식사요법' },
  { href: '/research', label: '연구' },
  { href: '/clinical-trials', label: '임상연구' },
  { href: '/contact', label: '연락하기' },
];
const NAV_EN = [
  { href: '/pathogenesis', label: 'About ALD' },
  { label: 'Phenotypes', children: [
      { href: '/cerebral-ald',          label: 'Cerebral ALD' },
      { href: '/amn',                   label: 'Adrenomyeloneuropathy' },
      { href: '/women',                 label: 'Women with ALD' },
      { href: '/adrenal-insufficiency', label: 'Adrenal Insufficiency' },
    ] },
  { href: '/newborn-screening', label: 'Newborn Screening' },
  { label: 'Treatment', children: [
      { href: '/treatment',                     label: 'Cerebral ALD Treatment' },
      { href: '/amn#treatment-and-care',        label: 'AMN Care' },
      { href: '/adrenal-insufficiency#treatment', label: 'Adrenal Management' },
    ] },
  { href: '/diet', label: 'Diet' },
  { href: '/research', label: 'Research' },
  { href: '/clinical-trials', label: 'Clinical Trials' },
  { href: '/contact', label: 'Contact' },
];
const nav = isEN ? NAV_EN : NAV_KO;

const T = isEN ? {
  htmlLang: 'en',
  siteName: 'Korea ALD',
  homeTitle: 'Korea ALD — Adrenoleukodystrophy Information',
  suffix: 'Korea ALD',
  eyebrow: 'Adrenoleukodystrophy',
  toc: 'On this page',
  footTag: 'Adrenoleukodystrophy · Information in English',
  disclaimer: 'This site provides information about adrenoleukodystrophy. It does not replace medical care. Diagnosis and treatment decisions rest with the treating clinicians.',
  cafe: 'ALD Bridge (Naver Cafe, Korean)',
  blog: 'Related blog (Korean)',
  admin: 'Admin',
  switch: '한국어',
  switchTo: '',
} : {
  htmlLang: 'ko',
  siteName: '부신백질이영양증(ALD) 정보',
  homeTitle: '부신백질이영양증(ALD) — 한국어 정보',
  suffix: '부신백질이영양증(ALD)',
  eyebrow: '부신백질이영양증',
  toc: '이 페이지 안에서',
  footTag: 'Adrenoleukodystrophy · 한국어 정보',
  disclaimer: '이 사이트는 부신백질이영양증에 대한 정보를 제공합니다. 진료나 상담을 대신하지 않으며, 개별 환자의 진단과 치료는 담당 의료진의 판단에 따릅니다.',
  cafe: 'ALD 브릿지 (네이버 카페)',
  blog: '관련 블로그',
  admin: '관리자',
  switch: 'English',
  switchTo: '/en',
};

const isOn = (item) =>
  item.href ? path === item.href.split('#')[0]
            : (item.children || []).some((c) => path === c.href.split('#')[0]);
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.org').href;
---
<!doctype html>
<html lang={T.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{home ? T.homeTitle : `${title} — ${T.suffix}`}</title>
  <meta name="description" content={description} />
  {(NOINDEX || noindex) && <meta name="robots" content="noindex, nofollow" />}
  {NAVER_VERIFY && <meta name="naver-site-verification" content={NAVER_VERIFY} />}
  {GOOGLE_VERIFY && <meta name="google-site-verification" content={GOOGLE_VERIFY} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={T.siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={isEN ? "en_US" : "ko_KR"} />
  <link rel="alternate" hreflang="ko" href={new URL(abs(path === "/" ? "/" : path), Astro.site).href} />
  <link rel="alternate" hreflang="en" href={new URL(abs("/en" + (path === "/" ? "/" : path)), Astro.site).href} />
  <link rel="icon" href={abs('/logo-mark.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={abs('/apple-touch-icon.png')} />
  <script is:inline>
    if ('IntersectionObserver' in window) document.documentElement.classList.add('js');
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard-dynamic-subset.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500;600&display=swap" />
  <style>
    :root {
      /* 종이 · 잉크 · 절제된 포인트 하나 */
      --paper:   #fbf9f6;
      --paper-2: #f4f0ea;
      --card:    #ffffff;
      --ink:     #15181c;
      --ink-2:   #3d4650;
      --muted:   #6b7580;
      --rule:    #e0dad1;
      --rule-2:  #cfc7bb;
      --deep:    #1e3d38;   /* 짙은 청록 — 강조 하나만 */
      --deep-2:  #2c5a52;
      --tint:    #eef2f0;

      --serif: 'Noto Serif KR', serif;
      --sans: 'Pretendard', 'Noto Sans KR', system-ui, -apple-system, sans-serif;

      --read: 50rem;   /* 본문 읽기 폭 */
      --wide: 84rem;   /* 헤더·홈·푸터 폭 */
      --shell: 92rem;  /* 본문 페이지 전체 폭 */
      --gap: 2.5rem;
      /* 본문 양옆에 남는 여백 — 화면 폭에 따라 자동 계산 */
      --gutter: max(0px, (min(var(--shell), 100vw - 2rem) - var(--read) - var(--gap) * 2) / 2);
      /* 제목선·표·그림이 오른쪽으로 뻗는 양 (여백을 넘지 않게) */
      --bleed: min(12rem, var(--gutter));
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; background: var(--paper); color: var(--ink);
      font-family: var(--sans); font-size: 18px; line-height: 1.85;
      word-break: keep-all; overflow-wrap: break-word;
      -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
    }
    a { color: var(--deep-2); text-underline-offset: 4px; }
    :global(.container) { max-width: var(--wide); margin: 0 auto; padding: 0 2.5rem; }

    :global(html.js .fade-up) {
      opacity: 0; transform: translateY(20px);
      transition: opacity .8s cubic-bezier(.22,1,.36,1), transform .8s cubic-bezier(.22,1,.36,1);
    }
    :global(html.js .fade-up.in) { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { :global(html.js .fade-up) { opacity: 1; transform: none; transition: none; } }

    /* ── 헤더 : 얇은 괘선, 색 없음 ── */
    .site-head {
      position: sticky; top: 0; z-index: 50;
      background: rgba(251,249,246,.92); backdrop-filter: saturate(180%) blur(12px);
      border-bottom: 1px solid var(--rule);
    }
    .head-inner {
      display: flex; align-items: center; gap: 2rem;
      min-height: 92px; max-width: var(--wide); margin: 0 auto; padding: 0 2.5rem;
    }
    .brand { display: flex; align-items: center; text-decoration: none; flex: none; }
    .brand img { height: 62px; width: auto; display: block; }

    nav.main { display: flex; gap: 1.6rem; margin-left: auto; align-items: stretch; }
    @media (min-width: 901px) { .langswitch { order: 99; } }
    .navgroup { position: relative; display: flex; }
    .navtop {
      position: relative; display: inline-flex; align-items: center; gap: .35rem;
      appearance: none; background: none; border: 0; cursor: pointer; font-family: inherit;
      text-decoration: none; color: var(--ink-2); font-size: .95rem; font-weight: 500;
      padding: 1.6rem 0; white-space: nowrap;
    }
    .navtop svg { width: 9px; height: 6px; fill: none; stroke: currentColor; stroke-width: 1.6;
                  stroke-linecap: round; stroke-linejoin: round; opacity: .55; transition: transform .25s; }
    .navtop::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 1.25rem; height: 1px;
      background: var(--ink); transform: scaleX(0); transform-origin: left;
      transition: transform .3s cubic-bezier(.22,1,.36,1);
    }
    .navtop:hover { color: var(--ink); }
    .navtop:hover::after { transform: scaleX(1); }
    .navtop.on, .navtop[aria-current="page"] { color: var(--deep); font-weight: 600; }
    .navtop.on::after, .navtop[aria-current="page"]::after { transform: scaleX(1); background: var(--deep); }

    .submenu {
      position: absolute; top: 100%; left: 50%; transform: translate(-50%, 6px);
      min-width: 15rem; background: var(--paper); border: 1px solid var(--rule);
      box-shadow: 0 14px 36px rgba(21,24,28,.10); padding: .5rem 0;
      opacity: 0; visibility: hidden; transition: opacity .2s, transform .2s, visibility .2s; z-index: 60;
    }
    .navgroup:hover .submenu,
    .navgroup:focus-within .submenu { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
    .navgroup:hover .navtop svg { transform: rotate(180deg); }
    .submenu a {
      display: block; padding: .62rem 1.2rem; text-decoration: none;
      color: var(--ink-2); font-size: .93rem; white-space: nowrap; border-left: 2px solid transparent;
    }
    .submenu a:hover { background: var(--paper-2); color: var(--ink); }
    .submenu a[aria-current="page"] { color: var(--deep); font-weight: 600; border-left-color: var(--deep); }

.langswitch {
      align-self: center; margin-left: 1.6rem; padding: .4rem .9rem;
      border: 1px solid var(--rule-2); text-decoration: none;
      color: var(--ink-2); font-size: .85rem; font-weight: 600; white-space: nowrap;
      transition: border-color .2s, color .2s;
    }
    .langswitch:hover { color: var(--deep); border-color: var(--deep); }
    .menu-toggle { display: none; margin-left: auto; }

    /* ── 페이지 머리 : 색 밴드 대신 여백과 괘선 ── */
    .page-head { border-bottom: 1px solid var(--rule); }
    .page-head .container { padding-block: 4.5rem 3rem; max-width: 92rem; }
    .page-head .inner { max-width: 62rem; }
    /* 제목 오른쪽으로 뻗는 선 — 넓은 화면의 빈 공간을 채웁니다 */
    .page-head .inner h1 { display: flex; align-items: center; gap: 1.75rem; }
    .page-head .inner h1::after {
      content: ''; flex: 1; height: 1px; background: var(--rule-2); min-width: 3rem;
    }
    .page-head .eyebrow {
      display: block; font-size: .8rem; font-weight: 600; letter-spacing: .18em;
      text-transform: uppercase; color: var(--muted); margin-bottom: 1.3rem;
    }
    .page-head h1 {
      font-family: var(--serif); font-weight: 500; color: var(--ink);
      font-size: clamp(2rem, 4.2vw, 3rem); line-height: 1.35; letter-spacing: -.03em; margin: 0;
    }

    /* ── 본문 ── */
    main { padding-bottom: 6rem; }

    /* 넓은 화면: 왼쪽 여백을 목차로 채웁니다 */
    .page-body {
      display: grid; grid-template-columns: 1fr minmax(0, var(--read)) 1fr;
      max-width: var(--shell); margin: 0 auto; padding: 0 1rem; column-gap: var(--gap);
    }
    .prose { grid-column: 2; max-width: var(--read); padding: 3.5rem 0 0; }

    .toc {
      grid-column: 1; justify-self: end;
      position: sticky; top: 8.5rem; align-self: start;
      width: min(15rem, 100%); margin-top: 4.2rem;
      max-height: calc(100vh - 10rem); overflow-y: auto;
    }
    .toc-title {
      font-size: .74rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
      color: var(--muted); margin: 0 0 1rem; padding-bottom: .7rem; border-bottom: 1px solid var(--rule);
    }
    .toc ol { list-style: none; margin: 0; padding: 0; counter-reset: toc; }
    .toc li { counter-increment: toc; margin-bottom: .1rem; }
    .toc a {
      display: block; padding: .42rem 0 .42rem 1.5rem; position: relative;
      color: var(--muted); text-decoration: none; font-size: .88rem; line-height: 1.55;
      border-left: 2px solid transparent; transition: color .2s, border-color .2s;
    }
    .toc a::before {
      content: counter(toc); position: absolute; left: .55rem; top: .42rem;
      font-size: .72rem; color: var(--rule-2); font-variant-numeric: tabular-nums;
    }
    .toc a:hover { color: var(--ink); }
    .toc a.active { color: var(--deep); font-weight: 600; border-left-color: var(--deep); }
    .toc a.active::before { color: var(--deep); }

    /* 스티키 헤더에 제목이 가리지 않도록 */
    .prose :global(h2), .prose :global(h3) { scroll-margin-top: 7.5rem; }

    /* ── 넓은 화면: 폭을 "글줄"이 아니라 "요소"로 채웁니다 ──
       글은 읽기 좋은 폭을 지키고, 제목선·표·그림만 오른쪽으로 더 뻗습니다. */
    @media (min-width: 1100px) {
      .prose :global(h2) { width: calc(100% + var(--bleed)); }
      .table-wrap { width: calc(100% + var(--bleed)); }
      .prose :global(p:has(> img)) { width: calc(100% + var(--bleed)); }
      .prose :global(hr) { width: calc(100% + var(--bleed)); }
    }

    @media (max-width: 1099px) {
      .page-body { grid-template-columns: minmax(0, var(--read)); justify-content: center; padding-inline: 1.75rem; }
      .toc { display: none; }
      .prose { grid-column: 1; }
    }
    .prose > :global(p:first-of-type) { font-size: 1.16rem; line-height: 1.8; color: var(--ink-2); }

    .prose :global(h2) {
      font-family: var(--serif); font-weight: 500; color: var(--ink);
      font-size: 1.72rem; line-height: 1.45; letter-spacing: -.028em;
      margin: 4rem 0 1.3rem; padding-top: 2.2rem; border-top: 1px solid var(--rule);
    }
    .prose :global(h3) {
      font-family: var(--serif); font-weight: 600; color: var(--deep);
      font-size: 1.22rem; margin: 2.6rem 0 .7rem; letter-spacing: -.02em;
    }
    .prose :global(p) { margin: 0 0 1.35rem; }
    .prose :global(ul), .prose :global(ol) { padding-left: 1.3rem; margin: 0 0 1.5rem; }
    .prose :global(li) { margin-bottom: .6rem; }
    .prose :global(li)::marker { color: var(--rule-2); }
    .prose :global(strong) { font-weight: 700; color: var(--ink); }
    .prose :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 3rem 0; }

    .prose :global(blockquote) {
      margin: 2rem 0; padding: .35rem 0 .35rem 1.6rem;
      border-left: 2px solid var(--deep); font-family: var(--serif);
      font-size: 1.06rem; line-height: 1.85; color: var(--ink-2);
    }
    .prose :global(blockquote > :last-child) { margin-bottom: 0; }
    .prose :global(blockquote strong) { color: var(--deep); }

    .table-wrap { overflow-x: auto; margin: 2rem 0; }
    .prose :global(table) { border-collapse: collapse; width: 100%; font-size: .97rem; }
    .prose :global(th), .prose :global(td) { padding: .8rem .9rem; text-align: left; vertical-align: top; }
    .prose :global(thead th) {
      font-family: var(--serif); font-weight: 600; color: var(--ink);
      border-bottom: 2px solid var(--ink); white-space: nowrap;
    }
    .prose :global(tbody tr) { border-bottom: 1px solid var(--rule); }

    .prose :global(img) {
      display: block; margin: 3rem auto; max-width: 100%; height: auto;
      padding: 1.6rem; background: var(--card); border: 1px solid var(--rule);
    }
    .prose :global(code) { background: var(--paper-2); padding: .12em .4em; border-radius: 3px; font-size: .9em; }
    .prose :global(em) { color: var(--muted); font-style: normal; font-size: .93em; }

    /* ── 푸터 ── */
    footer { border-top: 1px solid var(--rule); background: var(--paper-2); }
    footer .container { padding-block: 3.5rem 4rem; }
    .foot-grid { display: grid; grid-template-columns: 1.1fr 1.9fr; gap: 3rem; }
    .foot-brand { font-family: var(--serif); font-size: 1.3rem; font-weight: 500; color: var(--ink); margin: 0 0 .5rem; letter-spacing: -.02em; }
    .foot-sub { color: var(--muted); font-size: .93rem; margin: 0; }
    .foot-ext { display: flex; flex-direction: column; gap: .55rem; margin-top: 1.6rem; }
    .foot-ext a {
      display: inline-flex; align-items: center; gap: .45rem; align-self: flex-start;
      color: var(--deep); text-decoration: none; font-size: .95rem; font-weight: 600;
      border-bottom: 1px solid var(--rule-2); padding-bottom: .2rem;
    }
    .foot-ext a:hover { border-color: var(--deep); }
    .foot-ext i { font-style: normal; color: var(--muted); font-size: .9rem; }
    .foot-ext .admin-link {
      color: var(--muted); font-weight: 400; font-size: .85rem;
      border-bottom-color: transparent; margin-top: .4rem;
    }
    .foot-ext .admin-link:hover { color: var(--ink); border-bottom-color: var(--rule-2); }
    .foot-links { display: grid; grid-template-columns: repeat(2, 1fr); gap: .7rem 2rem; }
    .foot-links a { color: var(--ink-2); text-decoration: none; font-size: .95rem; }
    .foot-links a:hover { color: var(--deep); text-decoration: underline; }
    .foot-note { margin: 3rem 0 0; padding-top: 1.8rem; border-top: 1px solid var(--rule-2); color: var(--muted); font-size: .9rem; line-height: 1.8; max-width: 46rem; }

    @media (max-width: 900px) {
      :global(.container), .head-inner { padding-inline: 1.35rem; }
      body { font-size: 17px; }
      .head-inner { min-height: 70px; }
      nav.main {
        position: fixed; inset: 70px 0 auto 0; background: var(--paper); flex-direction: column;
        gap: 0; padding: .25rem 1.35rem 1.4rem; border-bottom: 1px solid var(--rule); display: none;
        max-height: calc(100vh - 70px); overflow-y: auto;
      }
      nav.main.open { display: flex; }
      .navgroup { display: block; }
      .navtop { width: 100%; justify-content: space-between; padding: .95rem 0;
                border-bottom: 1px solid var(--rule); font-size: 1.02rem; }
      .navtop::after { display: none; }
      .submenu {
        position: static; transform: none; opacity: 1; visibility: visible; display: none;
        min-width: 0; border: 0; box-shadow: none; background: var(--paper-2); padding: .3rem 0;
      }
      .navgroup.open .submenu { display: block; }
      .navgroup.open .navtop svg { transform: rotate(180deg); }
      .submenu a { padding: .75rem 1rem; border-bottom: 1px solid var(--rule); font-size: .97rem; }
      .submenu a:last-child { border-bottom: 0; }
      .langswitch { margin-left: auto; margin-right: .7rem; padding: .35rem .75rem; font-size: .8rem; }
      .menu-toggle {
        display: grid; place-items: center; width: 42px; height: 42px;
        background: none; border: 1px solid var(--rule-2); cursor: pointer;
      }
      .menu-toggle span { display: block; width: 18px; height: 1.5px; background: var(--ink); position: relative; }
      .menu-toggle span::before, .menu-toggle span::after {
        content: ''; position: absolute; left: 0; width: 18px; height: 1.5px; background: var(--ink);
      }
      .menu-toggle span::before { top: -6px; } .menu-toggle span::after { top: 6px; }
      .brand img { height: 46px; }
      .page-head .container { padding-block: 2.6rem 2rem; }
      .prose { padding-top: 2.4rem; }
      .prose :global(h2) { font-size: 1.42rem; margin-top: 3rem; }
      .foot-grid { grid-template-columns: 1fr; gap: 2rem; }
    }
  </style>
</head>
<body>
  <header class="site-head">
    <div class="head-inner">
      <a class="brand" href={url('/')} aria-label="KOREA ALD 홈으로">
        <img src={abs('/logo.svg')} alt="KOREA ALD" width="150" height="142" />
      </a>
      <a class="langswitch" href={abs(isEN ? (path === '/' ? '/' : path) : '/en' + (path === '/' ? '/' : path))}
         hreflang={isEN ? 'ko' : 'en'} aria-label={isEN ? '한국어로 보기' : 'View in English'}>{T.switch}</a>
      <button class="menu-toggle" aria-label={isEN ? 'Open menu' : '메뉴 열기'} aria-expanded="false"><span></span></button>
      <nav class="main" id="mainnav">
        {nav.map((n) => (
          n.children ? (
            <div class={`navgroup${isOn(n) ? ' on' : ''}`}>
              <button type="button" class="navtop" aria-expanded="false">
                {n.label}<svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg>
              </button>
              <div class="submenu">
                {n.children.map((c) => (
                  <a href={url(c.href)} aria-current={path === c.href.split('#')[0] ? 'page' : undefined}>{c.label}</a>
                ))}
              </div>
            </div>
          ) : (
            <a class={`navtop${isOn(n) ? ' on' : ''}`} href={url(n.href)}
               aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          )
        ))}
      </nav>
    </div>
  </header>

  {!home && (
    <div class="page-head">
      <div class="container">
        <div class="inner">
          <span class="eyebrow">{T.eyebrow}</span>
          <h1>{title}</h1>
        </div>
      </div>
    </div>
  )}

  <main>
    {home ? <slot /> : (
      <div class="page-body">
        {toc.length > 2 && (
          <aside class="toc" aria-label="이 페이지의 목차">
            <p class="toc-title">{T.toc}</p>
            <nav>
              <ol>
                {toc.map((h) => (
                  <li><a href={`#${h.slug}`}>{h.text.replace(/^\d+\.\s*/, '')}</a></li>
                ))}
              </ol>
            </nav>
          </aside>
        )}
        <div class="prose"><slot /></div>
      </div>
    )}
  </main>

  <footer>
    <div class="container">
      <div class="foot-grid">
        <div>
          <p class="foot-brand">{isEN ? "Korea ALD" : "부신백질이영양증"}</p>
          <p class="foot-sub">{T.footTag}</p>
          <div class="foot-ext">
            <a href="https://cafe.naver.com/aldbridge" target="_blank" rel="noopener">
              {T.cafe} <i>↗</i>
            </a>
            <a href="https://blog.naver.com/jeswow" target="_blank" rel="noopener">
              {T.blog} <i>↗</i>
            </a>
            <a class="admin-link" href={abs('/admin')}>{T.admin}</a>
          </div>
        </div>
        <div class="foot-links">
          {nav.flatMap((n) => n.children ? n.children : [n]).map((n) => <a href={url(n.href)}>{n.label}</a>)}
        </div>
      </div>
      <p class="foot-note">
        {T.disclaimer}
      </p>
    </div>
  </footer>

  <script is:inline>
    document.querySelectorAll('.prose table').forEach((t) => {
      if (t.parentElement?.classList.contains('table-wrap')) return;
      const w = document.createElement('div'); w.className = 'table-wrap';
      t.replaceWith(w); w.appendChild(t);
    });
    const btn = document.querySelector('.menu-toggle');
    const nav = document.getElementById('mainnav');
    btn?.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
    });
    // 모바일에서 하위 메뉴 펼치기 (데스크톱은 hover로 열림)
    document.querySelectorAll('.navgroup > .navtop').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!window.matchMedia('(max-width: 900px)').matches) return;
        var g = b.parentElement;
        var willOpen = !g.classList.contains('open');
        document.querySelectorAll('.navgroup').forEach(function (x) { x.classList.remove('open'); });
        g.classList.toggle('open', willOpen);
        b.setAttribute('aria-expanded', String(willOpen));
      });
    });
    // 목차: 현재 읽고 있는 절 표시
    (function () {
      var links = [...document.querySelectorAll('.toc a')];
      if (!links.length) return;
      var map = new Map();
      links.forEach(function (a) {
        var el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
        if (el) map.set(el, a);
      });
      var mark = function (a) { links.forEach(function (l) { l.classList.toggle('active', l === a); }); };
      var io = new IntersectionObserver(function (entries) {
        var visible = [...map.keys()].filter(function (el) {
          var r = el.getBoundingClientRect();
          return r.top < window.innerHeight * 0.5;
        });
        if (visible.length) mark(map.get(visible[visible.length - 1]));
      }, { rootMargin: '-20% 0px -70% 0px', threshold: 0 });
      map.forEach(function (a, el) { io.observe(el); });
    })();

    (function () {
      var items = document.querySelectorAll('.fade-up');
      if (!items.length) return;
      var revealed = 0;
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('in'); revealed++; io.unobserve(e.target); }
        });
      }, { rootMargin: '0px 0px -6% 0px', threshold: 0.04 });
      items.forEach(function (el) { io.observe(el); });
      setTimeout(function () { if (revealed === 0) document.documentElement.classList.remove('js'); }, 2500);
    })();
  </script>
</body>
</html>
