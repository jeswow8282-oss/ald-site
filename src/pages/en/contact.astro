---
import Base from '../../layouts/Base.astro';
---
<Base title="Contact" description="Research enquiries, and enquiries from patients and families.">
  <p>
    Enquiries about ALD are welcome. Please choose whichever applies below.
    What you send <strong>can be read only by the site operator.</strong>
  </p>

  <div class="tabs" role="tablist">
    <button class="tab is-on" data-type="patient" role="tab" aria-selected="true">Patients and families</button>
    <button class="tab" data-type="research" role="tab" aria-selected="false">Research</button>
  </div>

  <!-- ─────────── 환자·보호자 ─────────── -->
  <section class="pane" data-pane="patient">
    <div class="welcome">
      <p class="w-lead">You are not going through this alone.</p>
      <p>
        ALD affects so few people that, after a diagnosis, there is often no one nearby to ask.
        Patients and families in Korea keep in touch through a <strong>KakaoTalk group</strong> —
        sharing news, asking and answering, talking about which hospitals to go to, what symptoms
        they are living with, how school is going. People who have been through the same things.
      </p>
      <div class="rooms">
        <a class="room" href="https://open.kakao.com/o/gHadHNhe" target="_blank" rel="noopener">
          <span class="r-name">KakaoTalk group for patients and families <i>↗</i></span>
          <span class="r-note">A password is needed to join. Ask below and we will send it. In Korean.</span>
        </a>
        <a class="room" href="https://cafe.naver.com/aldbridge" target="_blank" rel="noopener">
          <span class="r-name">ALD Bridge (Naver Cafe) <i>↗</i></span>
          <span class="r-note">Run by a patient's family member. A Naver account is required. In Korean.</span>
        </a>
      </div>
      <p class="w-sub">
        Ask anything. There will be things we cannot answer, but we will look into it
        and tell you what we can.
      </p>
    </div>

    <details class="notice-fold">
      <summary>Before you write</summary>
      <ul>
        <li>This is <strong>not a clinical service.</strong> Questions about the diagnosis or treatment of an individual patient are for your treating clinicians.</li>
        <li><strong>In an emergency, go to hospital.</strong> Do not wait for a reply here.</li>
        <li>The site is run alongside other work, so <strong>replies may be slow.</strong></li>
        <li>Please <strong>do not include personal information that is not necessary</strong>, such as identification numbers or detailed medical history.</li>
        <li>If the form will not send, you can leave a comment on the <a href="https://blog.naver.com/jeswow" target="_blank" rel="noopener">blog</a> (Korean) instead.</li>
      </ul>
    </details>

    <p class="joincue">
      <strong>To join the KakaoTalk group, please write to us below.</strong>
      We will send you the password to enter.
      Writing <em>“I would like to join the group”</em> is enough.
    </p>

    <form class="cform" data-form="patient" novalidate>
      <label>
        <span>What should we call you? <em>required</em></span>
        <input name="name" type="text" maxlength="100" required placeholder="Name or a nickname" />
        <small>It does not have to be your real name.</small>
      </label>
      <fieldset class="reply-how">
        <legend>How would you like to be answered? <em>required</em></legend>
        <label class="radio">
          <input type="radio" name="prefer" value="email" checked />
          <span>By email</span>
        </label>
        <label class="radio">
          <input type="radio" name="prefer" value="phone" />
          <span>By telephone</span>
        </label>
      </fieldset>
      <label data-need="email">
        <span>Email address <em class="req-mark">required</em></span>
        <input name="email" type="email" maxlength="200" placeholder="name@example.com" />
        <small>Replies are sent from <strong>answer@kalds.org</strong>. Please check your spam folder.</small>
      </label>
      <label data-need="phone">
        <span>Telephone <em class="req-mark">optional</em></span>
        <input name="phone" type="tel" maxlength="30" placeholder="+82 10 0000 0000" />
        <small>Only needed if you would rather be telephoned.</small>
      </label>
      <label>
        <span>Your message <em>required</em></span>
        <textarea name="message" rows="9" maxlength="5000" required
          placeholder="For example:&#10;· I would like to join the KakaoTalk group&#10;· A family member has been diagnosed and we do not know where to go&#10;· Something on this site is unclear&#10;· I found something that appears to be wrong"></textarea>
        <small class="count">0 / 5000</small>
      </label>
      <div class="agree">
        <label class="chk">
          <input type="checkbox" name="agree" required />
          <span>I have read the notes above and agree that what I enter will be stored so that my
          enquiry can be handled. It is not used for anything else, and is deleted on request.</span>
        </label>
      </div>
      <button class="submit" type="submit">Send</button>
      <p class="result" role="status"></p>
    </form>
  </section>

  <!-- ─────────── 연구 ─────────── -->
  <section class="pane" data-pane="research" hidden>
    <div class="notice">
      <p><strong>Research enquiries</strong></p>
      <ul>
        <li>Collaboration, data requests and clinical trial enquiries are welcome.</li>
        <li>Please also get in touch if you are looking for data on the Korean ALD patient population.</li>
        <li>Including your affiliation and purpose will speed up a reply.</li>
        <li>If the form will not send, you can reach us through the <a href="https://blog.naver.com/jeswow" target="_blank" rel="noopener">blog</a> (Korean) instead.</li>
      </ul>
    </div>

    <form class="cform" data-form="research" novalidate>
      <label>
        <span>Name and affiliation <em>required</em></span>
        <input name="name" type="text" maxlength="100" required placeholder="e.g. Jane Doe / Department of Neurology, X University" />
      </label>
      <fieldset class="reply-how">
        <legend>How would you like to be answered? <em>required</em></legend>
        <label class="radio">
          <input type="radio" name="prefer" value="email" checked />
          <span>By email</span>
        </label>
        <label class="radio">
          <input type="radio" name="prefer" value="phone" />
          <span>By telephone</span>
        </label>
      </fieldset>
      <label data-need="email">
        <span>Email for reply <em class="req-mark">required</em></span>
        <input name="email" type="email" maxlength="200" placeholder="name@example.org" />
        <small>An institutional address is preferred. Replies come from <strong>answer@kalds.org</strong>.</small>
      </label>
      <label data-need="phone">
        <span>Telephone <em class="req-mark">optional</em></span>
        <input name="phone" type="tel" maxlength="30" placeholder="+82 10 0000 0000" />
      </label>
      <label>
        <span>Your message <em>required</em></span>
        <textarea name="message" rows="9" maxlength="5000" required
          placeholder="Research topic, the collaboration you have in mind, or the data you need."></textarea>
        <small class="count">0 / 5000</small>
      </label>
      <div class="agree">
        <label class="chk">
          <input type="checkbox" name="agree" required />
          <span>I agree that what I enter will be stored so that my enquiry can be answered.
          It is not used for anything else, and is deleted on request.</span>
        </label>
      </div>
      <button class="submit" type="submit">Send</button>
      <p class="result" role="status"></p>
    </form>
  </section>

  <hr />

  <h2>How your message is handled</h2>
  <ul>
    <li>Messages <strong>can be read only by the site operator.</strong> Neither other visitors nor the sender can retrieve them afterwards.</li>
    <li>They are not used for any purpose other than answering the enquiry, and are not shared with third parties.</li>
    <li>Messages are deleted periodically once answered.</li>
    <li>The only items collected are <strong>a name to use, contact details and the message itself.</strong></li>
  </ul>
</Base>

<style>
  /* display 를 지정한 요소에는 브라우저 기본 [hidden] 규칙이 먹지 않는다.
     (.notice 의 display:flex 가 이겨서 hidden=true 인데도 계속 보였다)
     hidden 은 '숨긴다'는 뜻이므로 어떤 경우에도 숨게 못박아 둔다. */
  [hidden] { display: none !important; }

  .tabs { display: flex; gap: 0; margin: 2.5rem 0 0; border-bottom: 1px solid var(--rule); }
  .tab {
    appearance: none; background: none; border: 0; cursor: pointer;
    font-family: inherit; font-size: 1rem; font-weight: 600; color: var(--muted);
    padding: .9rem 1.4rem; border-bottom: 2px solid transparent; margin-bottom: -1px;
    transition: color .2s, border-color .2s;
  }
  .tab:hover { color: var(--ink); }
  .tab.is-on { color: var(--deep); border-bottom-color: var(--deep); }

  .pane { padding-top: 2.2rem; }

  .notice {
    background: var(--paper-2); border-left: 3px solid var(--deep);
    padding: 1.2rem 1.4rem; margin-bottom: 2.2rem;
  }
  .notice p { margin: 0 0 .6rem; }
  .notice ul { margin: 0; padding-left: 1.2rem; }
  .notice li { margin-bottom: .45rem; font-size: .96rem; color: var(--ink-2); }
  .notice li:last-child { margin-bottom: 0; }

  .welcome {
    background: var(--tint, #eef2f0); border-left: 3px solid var(--deep);
    padding: 1.5rem 1.6rem; margin-bottom: 1.4rem;
  }
  .welcome p { margin: 0 0 .9rem; font-size: .98rem; line-height: 1.85; color: var(--ink-2); }
  .welcome p:last-child { margin-bottom: 0; }
  .welcome .w-lead {
    font-family: var(--serif); font-size: 1.22rem; font-weight: 600;
    color: var(--deep); margin-bottom: 1rem; line-height: 1.5;
  }
  .welcome .w-sub { color: var(--muted); font-size: .94rem; }
  .welcome a { color: var(--deep-2); }
  .welcome strong { color: var(--ink); }

  .rooms { display: grid; gap: .6rem; margin: 0 0 .9rem; }
  .room {
    display: block; background: #fff; border: 1px solid var(--rule);
    padding: .95rem 1.1rem; text-decoration: none; transition: border-color .2s;
  }
  .room:hover { border-color: var(--deep); }
  .r-name { display: block; font-weight: 700; color: var(--deep); font-size: 1rem; margin-bottom: .25rem; }
  .r-name i { font-style: normal; font-size: .9rem; opacity: .6; }
  .r-note { display: block; color: var(--muted); font-size: .89rem; line-height: 1.6; }

  .notice-fold { margin-bottom: 2.2rem; border-bottom: 1px solid var(--rule); }
  .notice-fold summary {
    cursor: pointer; padding: .8rem 0; font-size: .94rem; font-weight: 600; color: var(--muted);
  }
  .notice-fold summary:hover { color: var(--ink); }
  .notice-fold ul { margin: 0 0 1.2rem; padding-left: 1.2rem; }
  .notice-fold li { margin-bottom: .5rem; font-size: .94rem; color: var(--ink-2); line-height: 1.75; }
  .notice-fold a { color: var(--deep-2); }
  .notice a { color: var(--deep-2); }
  .result a { color: var(--deep-2); }

  .joincue {
    background: var(--paper-2); border-left: 3px solid var(--deep-2);
    padding: 1rem 1.2rem; margin: 0 0 2rem;
    font-size: .97rem; line-height: 1.8; color: var(--ink-2);
  }
  .joincue strong { color: var(--deep); }
  .joincue em { font-style: normal; color: var(--muted); }

  .cform { display: grid; gap: 1.7rem; }
  .cform > label { display: grid; gap: .5rem; }
  .cform > label > span { font-weight: 600; font-size: .98rem; }
  .cform em { font-style: normal; color: var(--deep-2); font-size: .82rem; margin-left: .4rem; font-weight: 500; }
  .cform input, .cform textarea {
    font-family: inherit; font-size: 1rem; line-height: 1.7; color: var(--ink);
    background: #fff; border: 1px solid var(--rule-2); padding: .8rem .9rem;
    width: 100%; border-radius: 0;
  }
  .cform input:focus, .cform textarea:focus {
    outline: none; border-color: var(--deep); box-shadow: 0 0 0 3px rgba(30,61,56,.09);
  }
  .cform textarea { resize: vertical; }
  .cform small { color: var(--muted); font-size: .86rem; }
  .count { justify-self: end; font-variant-numeric: tabular-nums; }

  .agree { background: var(--paper-2); padding: 1rem 1.1rem; }
  .chk { display: flex; gap: .7rem; align-items: flex-start; cursor: pointer; }
  .chk input { width: auto; margin-top: .35rem; flex: none; }
  .chk span { font-size: .93rem; color: var(--ink-2); line-height: 1.65; }

  .submit {
    justify-self: start; appearance: none; border: 0; cursor: pointer;
    font-family: inherit; font-size: 1rem; font-weight: 600;
    background: var(--deep); color: var(--paper); padding: .9rem 2.4rem;
    transition: background .25s;
  }
  .submit:hover:not(:disabled) { background: var(--deep-2); }
  .submit:disabled { opacity: .5; cursor: default; }

  .result { margin: 0; font-size: .95rem; min-height: 1.4em; }
  .result.ok { color: var(--deep); font-weight: 600; }
  .result.err { color: #9a3412; }

  @media (max-width: 560px) {
    .tab { padding: .8rem .9rem; font-size: .93rem; }
    .submit { width: 100%; text-align: center; }
  }
  .reply-how {
    margin: 0 0 1.4rem; padding: 1rem 1.1rem;
    border: 1px solid var(--rule); border-radius: 2px; background: var(--paper-2);
  }
  .reply-how legend {
    padding: 0 .4rem; font-weight: 600; font-size: .95rem; color: var(--ink);
  }
  .reply-how legend em { font-style: normal; color: var(--deep); font-size: .82rem; margin-left: .3rem; }
  .reply-how .radio {
    display: flex; align-items: center; gap: .5rem; margin: .35rem 0; cursor: pointer;
    font-size: .97rem; color: var(--ink-2);
  }
  .reply-how .radio input { width: 1.05rem; height: 1.05rem; accent-color: var(--deep); flex: none; }
  /* 고르지 않은 쪽은 남겨두되 눈에 덜 띄게 한다 */
  .cform [data-need] { opacity: .55; transition: opacity .2s; }
  .cform [data-need].is-needed { opacity: 1; }
  .cform [data-need] .req-mark { font-style: normal; color: var(--muted); font-size: .82rem; }
  .cform [data-need].is-needed .req-mark { color: var(--deep); }
</style>

<script>
  import { auth, db } from '../../lib/firebase.js';
  import { signInAnonymously } from 'firebase/auth';
  import { collection, addDoc, serverTimestamp } from 'firebase/firestore';

  // 탭 전환
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const panes = document.querySelectorAll<HTMLElement>('.pane');
  tabs.forEach((t) => {
    t.addEventListener('click', () => {
      const type = t.dataset.type;
      tabs.forEach((x) => {
        const on = x === t;
        x.classList.toggle('is-on', on);
        x.setAttribute('aria-selected', String(on));
      });
      panes.forEach((p) => { p.hidden = p.dataset.pane !== type; });
    });
  });

  // 글자 수 표시
  document.querySelectorAll<HTMLTextAreaElement>('textarea[name="message"]').forEach((ta) => {
    const count = ta.parentElement?.querySelector('.count');
    const upd = () => { if (count) count.textContent = `${ta.value.length} / 5000`; };
    ta.addEventListener('input', upd); upd();
  });

  // Show whichever contact field the chosen reply method needs
  document.querySelectorAll<HTMLFormElement>('.cform').forEach((form) => {
    const sync = () => {
      const pref = (form.querySelector<HTMLInputElement>('[name="prefer"]:checked')?.value) || 'email';
      form.querySelectorAll<HTMLElement>('[data-need]').forEach((el) => {
        const needed = el.dataset.need === pref;
        el.classList.toggle('is-needed', needed);
        const mark = el.querySelector('.req-mark');
        if (mark) mark.textContent = needed ? 'required' : 'optional';
      });
    };
    form.querySelectorAll('[name="prefer"]').forEach((r) => r.addEventListener('change', sync));
    sync();
  });

  // 제출
  document.querySelectorAll<HTMLFormElement>('.cform').forEach((form) => {
    const btn = form.querySelector<HTMLButtonElement>('.submit')!;
    const out = form.querySelector<HTMLParagraphElement>('.result')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      out.className = 'result'; out.textContent = '';

      const fd = new FormData(form);
      const name = String(fd.get('name') || '').trim();
      const email = String(fd.get('email') || '').trim();
      const phone = String(fd.get('phone') || '').trim();
      const prefer = String(fd.get('prefer') || 'email');
      const message = String(fd.get('message') || '').trim();

      if (!name || !message) {
        out.className = 'result err'; out.textContent = 'Please complete all required fields.'; return;
      }
      if (prefer === 'email' && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        out.className = 'result err';
        out.textContent = 'To be answered by email, please enter a valid email address.'; return;
      }
      if (prefer === 'phone' && phone.replace(/[^0-9]/g, '').length < 9) {
        out.className = 'result err';
        out.textContent = 'To be answered by telephone, please enter a phone number.'; return;
      }
      if (!fd.get('agree')) {
        out.className = 'result err'; out.textContent = 'Please tick the consent box.'; return;
      }

      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        if (!auth.currentUser) await signInAnonymously(auth);
        // Before the updated rules are published the new fields are rejected.
        // Fall back to the old shape rather than lose the enquiry.
        try {
          await addDoc(collection(db, 'submissions'), {
            type: form.dataset.form,
            name, message, prefer,
            email: prefer === 'email' ? email : (email || ''),
            phone: prefer === 'phone' ? phone : (phone || ''),
            createdAt: serverTimestamp(),
            status: 'new',
          });
        } catch (e: any) {
          if (e?.code !== 'permission-denied') throw e;
          const legacy = prefer === 'phone'
            ? `${phone} (prefers a telephone reply)`
            : email + (phone ? ` / ${phone}` : '');
          await addDoc(collection(db, 'submissions'), {
            type: form.dataset.form,
            name, message,
            contact: legacy.slice(0, 200),
            createdAt: serverTimestamp(),
            status: 'new',
          });
        }
        form.reset();
        form.querySelectorAll('.count').forEach((c) => { c.textContent = '0 / 5000'; });
        out.className = 'result ok';
        out.textContent = prefer === 'phone'
          ? 'Thank you. We will look at this and telephone you on the number you gave.'
          : 'Thank you. We will look at this and reply to the address you gave. '
            + 'Replies come from answer@kalds.org, so please check your spam folder.';
      } catch (err) {
        console.error(err);
        out.className = 'result err';
        out.innerHTML = 'Sending failed. Please try again shortly.<br>If it keeps failing, you can leave a comment on the <a href="https://blog.naver.com/jeswow" target="_blank" rel="noopener">blog</a> (Korean) instead.';
      } finally {
        btn.disabled = false; btn.textContent = 'Send';
      }
    });
  });
</script>
