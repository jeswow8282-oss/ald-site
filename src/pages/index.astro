---
import Base from '../layouts/Base.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p) => BASE + p;

const phenotypes = [
  { href: '/treatment', tag: '소아기 · 급격히', title: '대뇌형 (cALD)',
    body: '어느 시점에 켜지는 염증으로 빠르게 진행합니다. 조기 조혈모세포이식이 현재 유일하게 확립된 치료이며, 발견 시점이 결과를 좌우합니다.',
    meta: '이식 · 레리글리타존 · 유전자치료' },
  { href: '/amn', tag: '성인기 · 서서히', title: '부신척수신경병증 (AMN)',
    body: 'ABCD1 변이를 가진 남성 대부분이 결국 겪는 경과입니다. 척수가 오랜 시간에 걸쳐 손상되며, 대뇌형 전환 감시가 함께 필요합니다.',
    meta: '보행 · 강직 · 감각 · 배뇨' },
  { href: '/women', tag: '여성', title: '여성 ALD',
    body: 'ABCD1 변이를 가진 여성은 보인자가 아니라 환자입니다. 척수 증상으로 나타나며, 대뇌형은 사실상 생기지 않습니다.',
    meta: '증상 · 진단 · 오진' },
  { href: '/adrenal-insufficiency', tag: '부신', title: '부신기능부전',
    body: 'ALD 남성에게 흔하고, 신경 증상보다 먼저 오기도 합니다. 가장 놓치기 쉬우면서 가장 위험한 부분입니다.',
    meta: '증상 · 검사 주기 · 관리' },
];

const others = [
  { href: '/pathogenesis', n: 'I', title: '왜 이 병이 생기고, 왜 사람마다 다른가',
    body: 'ABCD1과 긴꼬리지방산, 같은 변이에서 다른 병이 되는 이유, 최근 10년간 이해가 달라진 부분.' },
  { href: '/newborn-screening', n: 'II', title: '신생아 선별검사',
    body: '조기에 발견하면 치료할 수 있고 늦으면 치료할 수 없는 병에서, 발견 시점을 앞당기는 방법. 한국과 다른 나라의 현황.' },
  { href: '/diet', n: 'III', title: '식사요법',
    body: '식품군별 허용·주의·제한 식품, 로렌조오일, 자주 생기는 문제. 국내 첫 ALD 식단 지침서를 바탕으로 정리했습니다.' },
  { href: '/survey-2016', n: 'IV', title: '2016년 환우회 설문 조사',
    body: '국내 ALD 환자군의 모습을 수치로 남긴 거의 유일한 자료. 10년 전이라는 한계와 함께 읽어야 합니다.' },
];

const notes = [
  { h: '근거', p: '발표된 연구와 2022년 국제 합의 진료 권고를 바탕으로 작성했으며, 근거는 각 페이지 본문에 표시했습니다.' },
  { h: '검토일', p: '각 페이지 하단에 최종 검토일이 있습니다. 의학 정보는 시간이 지나면 달라지므로 함께 확인하시면 됩니다.' },
  { h: '범위', p: '이 사이트는 정보를 제공하는 곳이며, 진료나 상담을 대신하지 않습니다.' },
  { h: '정정', p: '잘못된 내용이나 보완이 필요한 부분에 대한 지적을 환영합니다.' },
];
---
<Base home title="부신백질이영양증 (ALD)">
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">X 연관 부신백질이영양증 · Adrenoleukodystrophy</p>
      <h1>지금까지 밝혀진 것과<br /><span>아직 밝혀지지 않은 것</span></h1>
      <div class="hero-body">
        <p class="lead">
          ALD는 ABCD1 유전자의 이상으로 포화 긴꼬리지방산이 몸에 쌓이면서
          신경과 부신에 손상이 생기는 유전 대사질환입니다.
          같은 변이에서 출발하지만 사람마다 전혀 다른 모습으로 나타납니다.
        </p>
        <p class="sub">
          국내에는 이 질환에 대한 한국어 자료가 많지 않습니다.
          이 사이트는 발표된 연구와 국제 진료 권고를 근거로 그 내용을 정리해 둔 곳입니다.
        </p>
        <div class="actions">
          <a class="btn" href={url('/pathogenesis')}>어떤 병인지부터 보기</a>
          <a class="link-btn" href={url('/treatment')}>치료 현황 →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 표현형 -->
  <section class="sec">
    <div class="container">
      <header class="sec-head fade-up">
        <span class="label">표현형</span>
        <h2>같은 병이지만, 완전히 다릅니다</h2>
        <p>대뇌형에 해당하는 이야기가 부신척수신경병증(AMN)에는 해당하지 않고, 그 반대도 마찬가지입니다.</p>
      </header>
      <div class="cards">
        {phenotypes.map((c) => (
          <a class="card fade-up" href={url(c.href)}>
            <span class="tag">{c.tag}</span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
            <span class="meta">{c.meta}</span>
            <span class="more">자세히 보기 <i>→</i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 그 밖에 -->
  <section class="sec bordered">
    <div class="container">
      <header class="sec-head fade-up">
        <span class="label">더 알아보기</span>
        <h2>배경과 제도, 그리고 자료</h2>
      </header>
      <ol class="rows">
        {others.map((c) => (
          <li class="fade-up">
            <a class="row" href={url(c.href)}>
              <span class="num">{c.n}</span>
              <span class="txt">
                <strong>{c.title}</strong>
                <span>{c.body}</span>
              </span>
              <span class="arrow">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 커뮤니티 : 유일한 짙은 면 -->
  <section class="community">
    <div class="container comm-inner">
      <div class="fade-up">
        <span class="label light">커뮤니티</span>
        <h2>함께 이야기 나눌 곳</h2>
        <p>이 사이트는 정보를 정리해 두는 곳입니다.
           다른 환우·보호자와 직접 이야기를 나누실 수 있는 곳은 따로 있습니다.</p>
      </div>
      <div class="links fade-up">
        <a class="link" href="https://cafe.naver.com/aldbridge" target="_blank" rel="noopener">
          <span><strong>ALD 브릿지</strong>환우와 보호자들이 모여 있는 네이버 카페입니다. 로그인과 가입이 필요합니다.</span>
          <i>↗</i>
        </a>
        <a class="link" href="https://blog.naver.com/jeswow" target="_blank" rel="noopener">
          <span><strong>관련 블로그</strong>ALD 관련 소식과 자료를 정리해 온 블로그입니다.</span>
          <i>↗</i>
        </a>
      </div>
    </div>
  </section>

  <!-- 안내 -->
  <section class="sec">
    <div class="container">
      <header class="sec-head fade-up"><span class="label">안내</span><h2>이 사이트에 대하여</h2></header>
      <div class="notes">
        {notes.map((n) => (
          <div class="note fade-up"><h4>{n.h}</h4><p>{n.p}</p></div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── HERO ── */
  .hero { padding: 6rem 0 5.5rem; border-bottom: 1px solid var(--rule); }
  .eyebrow {
    font-size: .8rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 1.8rem;
  }
  .hero h1 {
    font-family: var(--serif); font-weight: 500; margin: 0 0 3rem;
    font-size: clamp(2.3rem, 5.4vw, 4.1rem); line-height: 1.28; letter-spacing: -.04em;
    color: var(--ink); max-width: 22ch;
  }
  .hero h1 span { color: var(--deep); }
  .hero-body {
    display: grid; grid-template-columns: 1.15fr 1fr; gap: 3rem 4rem; align-items: start;
    padding-top: 2.5rem; border-top: 1px solid var(--rule);
  }
  .lead { font-size: 1.2rem; line-height: 1.85; color: var(--ink-2); margin: 0; font-family: var(--serif); font-weight: 400; }
  .sub { font-size: 1rem; line-height: 1.9; color: var(--muted); margin: 0; }
  .actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 1.6rem; }
  .btn {
    display: inline-block; padding: .95rem 2rem; background: var(--deep); color: var(--paper);
    text-decoration: none; font-weight: 600; font-size: 1rem; letter-spacing: -.01em;
    transition: background .25s;
  }
  .btn:hover { background: var(--deep-2); }
  .link-btn { text-decoration: none; color: var(--ink); font-weight: 600; font-size: 1rem; border-bottom: 1px solid var(--rule-2); padding-bottom: .2rem; }
  .link-btn:hover { border-color: var(--ink); }

  /* ── 섹션 공통 ── */
  .sec { padding: 6rem 0; }
  .sec.bordered { border-top: 1px solid var(--rule); }
  .sec-head { max-width: 38rem; margin-bottom: 3.5rem; }
  .label {
    display: block; font-size: .78rem; font-weight: 600; letter-spacing: .18em;
    text-transform: uppercase; color: var(--muted); margin-bottom: 1.1rem;
  }
  .label.light { color: rgba(255,255,255,.55); }
  .sec-head h2 {
    font-family: var(--serif); font-weight: 500; color: var(--ink);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem); line-height: 1.38; letter-spacing: -.032em; margin: 0;
  }
  .sec-head p { color: var(--muted); margin: 1.1rem 0 0; font-size: 1.03rem; line-height: 1.85; }

  /* ── 카드 ── */
  .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .card {
    position: relative; display: flex; flex-direction: column;
    padding: 2.6rem 2.4rem 2.3rem; text-decoration: none; color: inherit;
    background: var(--card); border: 1px solid var(--rule);
    transition: transform .35s cubic-bezier(.22,1,.36,1), box-shadow .35s, border-color .35s;
  }
  /* 위쪽에 가느다란 강조선 — 호버하면 채워집니다 */
  .card::before {
    content: ''; position: absolute; top: -1px; left: -1px; right: -1px; height: 2px;
    background: var(--deep); transform: scaleX(0); transform-origin: left;
    transition: transform .45s cubic-bezier(.22,1,.36,1);
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(30, 61, 56, .09);
    border-color: var(--rule-2);
  }
  .card:hover::before { transform: scaleX(1); }
  .tag { font-size: .78rem; font-weight: 600; letter-spacing: .1em; color: var(--muted); text-transform: uppercase; margin-bottom: 1.4rem; }
  .card h3 { font-family: var(--serif); font-weight: 600; color: var(--ink); font-size: 1.5rem; margin: 0 0 .9rem; letter-spacing: -.025em; }
  .card p { color: var(--ink-2); font-size: 1rem; line-height: 1.8; margin: 0 0 1.6rem; }
  .card .meta { font-size: .88rem; color: var(--muted); margin-bottom: 1.6rem; }
  .card .more { margin-top: auto; font-size: .95rem; font-weight: 600; color: var(--deep); display: flex; gap: .5rem; }
  .card .more i { font-style: normal; transition: transform .3s cubic-bezier(.22,1,.36,1); }
  .card:hover .more i { transform: translateX(5px); }

  /* ── 목록 ── */
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .rows li { border-bottom: 1px solid var(--rule); }
  .row {
    display: grid; grid-template-columns: 3.5rem 1fr auto; gap: 1.5rem; align-items: baseline;
    padding: 2.1rem .5rem; text-decoration: none; color: inherit; transition: padding-left .3s cubic-bezier(.22,1,.36,1);
  }
  .row:hover { padding-left: 1.3rem; }
  .num { font-family: var(--serif); font-size: 1rem; color: var(--rule-2); letter-spacing: .08em; }
  .txt strong { display: block; font-family: var(--serif); font-weight: 600; color: var(--ink); font-size: 1.32rem; margin-bottom: .45rem; letter-spacing: -.025em; }
  .txt span { color: var(--ink-2); font-size: 1rem; line-height: 1.8; }
  .arrow { color: var(--rule-2); font-size: 1.15rem; transition: color .3s; }
  .row:hover .arrow { color: var(--deep); }

  /* ── 커뮤니티 ── */
  .community { background: var(--deep); color: var(--paper); padding: 6rem 0; }
  .comm-inner { display: grid; grid-template-columns: 1fr 1.3fr; gap: 4rem; align-items: center; }
  .community h2 { font-family: var(--serif); font-weight: 500; font-size: clamp(1.7rem, 3.2vw, 2.3rem); margin: 0 0 1rem; letter-spacing: -.03em; line-height: 1.4; }
  .comm-inner > div > p { color: rgba(255,255,255,.66); margin: 0; font-size: 1rem; line-height: 1.85; }
  .links { display: grid; }
  .link {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 1.7rem 0; text-decoration: none; color: var(--paper);
    border-top: 1px solid rgba(255,255,255,.18); transition: padding-left .3s cubic-bezier(.22,1,.36,1);
  }
  .link:last-child { border-bottom: 1px solid rgba(255,255,255,.18); }
  .link:hover { padding-left: 1rem; }
  .link strong { display: block; font-family: var(--serif); font-weight: 600; font-size: 1.22rem; margin-bottom: .35rem; }
  .link span { color: rgba(255,255,255,.62); font-size: .95rem; line-height: 1.75; }
  .link i { font-style: normal; color: rgba(255,255,255,.5); font-size: 1.2rem; }
  .link:hover i { color: var(--paper); }

  /* ── 안내 ── */
  .notes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid var(--rule); }
  .note { padding: 2rem 1.8rem 2rem 0; border-right: 1px solid var(--rule); }
  .note:last-child { border-right: 0; }
  .note:not(:first-child) { padding-left: 1.8rem; }
  .note h4 { font-family: var(--serif); font-weight: 600; color: var(--deep); font-size: 1.05rem; margin: 0 0 .7rem; }
  .note p { color: var(--ink-2); font-size: .95rem; line-height: 1.8; margin: 0; }

  @media (max-width: 1000px) {
    .cards { grid-template-columns: 1fr; }
    .notes { grid-template-columns: repeat(2, 1fr); }
    .note:nth-child(2) { border-right: 0; }
    .note:nth-child(3) { padding-left: 0; border-top: 1px solid var(--rule); border-right: 1px solid var(--rule); }
    .note:nth-child(4) { border-top: 1px solid var(--rule); }
    .comm-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  }
  @media (max-width: 900px) {
    .hero { padding: 3.5rem 0 3.2rem; }
    .hero h1 { margin-bottom: 2rem; }
    .hero-body { grid-template-columns: 1fr; gap: 1.5rem; padding-top: 1.8rem; }
    .lead { font-size: 1.1rem; }
    .sec, .community { padding: 3.5rem 0; }
    .sec-head { margin-bottom: 2rem; }
    .card { padding: 1.8rem 1.5rem; }
    .row { grid-template-columns: 2.2rem 1fr; gap: 1rem; padding: 1.6rem .2rem; }
    .row .arrow { display: none; }
    .notes { grid-template-columns: 1fr; }
    .note { padding: 1.6rem 0 !important; border-right: 0 !important; border-top: 1px solid var(--rule); }
    .note:first-child { border-top: 0; }
    .actions { flex-direction: column; align-items: stretch; gap: 1.1rem; }
    .btn { text-align: center; }
    .link-btn { text-align: center; border-bottom: 0; }
  }
</style>
