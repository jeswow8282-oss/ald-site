---
import Base from '../layouts/Base.astro';
---
<Base title="관리자" description="문의 내역 열람" noindex>
  <!-- 로그인 화면 -->
  <section id="login">
    <p id="lead">등록된 관리자만 문의 내역을 볼 수 있습니다.</p>
    <form id="loginForm" class="lform" novalidate>
      <label>
        <span>이메일</span>
        <input name="email" type="email" autocomplete="username" required />
      </label>
      <label>
        <span>비밀번호</span>
        <input name="password" type="password" autocomplete="current-password" required minlength="6" />
        <small id="pwhint" hidden>6자 이상. 본인만 아는 것으로 정하세요.</small>
      </label>
      <button class="submit" type="submit" id="mainBtn">로그인</button>
      <p class="result" role="status"></p>
    </form>

    <div class="alt">
      <p id="altText">처음 오셨나요? <button type="button" class="linkbtn" data-toggle>계정 만들기</button></p>
      <p><button type="button" class="linkbtn" id="reset">비밀번호를 잊으셨나요?</button></p>
    </div>

    <div class="howto">
      <p><strong>관리자 계정은 이렇게 만듭니다</strong></p>
      <ol>
        <li>기존 관리자가 <strong>새 관리자의 이메일을 명단에 등록</strong>합니다.</li>
        <li>새 관리자가 이 화면에서 <strong>직접 계정을 만듭니다.</strong> 비밀번호는 본인만 압니다.</li>
        <li>명단에 없는 이메일로 만든 계정은 <strong>즉시 삭제</strong>되며 아무것도 볼 수 없습니다.</li>
      </ol>
    </div>
  </section>

  <!-- 문의함 -->
  <section id="inbox" hidden>
    <div class="bar">
      <div>
        <strong id="who"></strong>
        <span id="stat" class="muted"></span>
      </div>
      <button id="logout" class="ghost">로그아웃</button>
    </div>

    <div id="verifyBanner" class="notice" hidden>
      <p><strong>이메일 인증이 아직 되어 있지 않습니다.</strong>
         받은 편지함에서 인증 링크를 눌러 주십시오. 인증이 확인되면 이 안내는 사라집니다.</p>
      <button id="resendVerify" class="ghost">인증 메일 다시 보내기</button>
      <span id="verifyMsg" class="muted"></span>
    </div>

    <div class="filters">
      <button class="fbtn is-on" data-f="all">전체</button>
      <button class="fbtn" data-f="patient">환자 · 보호자</button>
      <button class="fbtn" data-f="research">연구</button>
      <button class="fbtn" data-f="new">미확인</button>
    </div>

    <div id="list" class="list"><p class="muted">불러오는 중…</p></div>
  </section>
</Base>

<style>
  .lform { display: grid; gap: 1.3rem; max-width: 24rem; margin-top: 2rem; }
  .lform label { display: grid; gap: .45rem; }
  .lform span { font-weight: 600; font-size: .95rem; }
  .lform input {
    font-family: inherit; font-size: 1rem; color: var(--ink); background: #fff;
    border: 1px solid var(--rule-2); padding: .75rem .9rem; width: 100%;
  }
  .lform input:focus { outline: none; border-color: var(--deep); box-shadow: 0 0 0 3px rgba(30,61,56,.09); }
  .submit {
    justify-self: start; appearance: none; border: 0; cursor: pointer; font-family: inherit;
    font-size: 1rem; font-weight: 600; background: var(--deep); color: var(--paper); padding: .85rem 2.2rem;
  }
  .submit:disabled { opacity: .5; }
  .ghost {
    appearance: none; background: none; cursor: pointer; font-family: inherit; font-size: .9rem;
    color: var(--muted); border: 1px solid var(--rule-2); padding: .45rem 1rem;
  }
  .ghost:hover { color: var(--ink); border-color: var(--ink); }
  .result { margin: 0; font-size: .93rem; min-height: 1.3em; }
  .result.err { color: #9a3412; }
  .result.ok { color: var(--deep); font-weight: 600; }

  .alt { margin-top: 1.6rem; display: grid; gap: .4rem; }
  .alt p { margin: 0; font-size: .93rem; color: var(--muted); }
  .linkbtn {
    appearance: none; background: none; border: 0; padding: 0; cursor: pointer;
    font-family: inherit; font-size: inherit; color: var(--deep-2); font-weight: 600;
    text-decoration: underline; text-underline-offset: 3px;
  }
  .linkbtn:hover { color: var(--ink); }

  .howto {
    margin-top: 3rem; padding: 1.3rem 1.5rem; background: var(--paper-2);
    border-left: 3px solid var(--rule-2); max-width: 34rem;
  }
  .howto p { margin: 0 0 .7rem; font-size: .95rem; }
  .howto ol { margin: 0; padding-left: 1.3rem; }
  .howto li { font-size: .92rem; color: var(--ink-2); margin-bottom: .45rem; line-height: 1.7; }
  .howto li:last-child { margin-bottom: 0; }

  .bar {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: 1rem 0 1.2rem; border-bottom: 1px solid var(--rule); margin-top: 1.5rem;
  }
  .muted { color: var(--muted); font-size: .9rem; }
  #stat { margin-left: .7rem; }

  .filters { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0 2rem; }
  .fbtn {
    appearance: none; background: none; cursor: pointer; font-family: inherit;
    font-size: .88rem; font-weight: 600; color: var(--muted);
    border: 1px solid var(--rule-2); padding: .42rem 1rem;
  }
  .fbtn:hover { color: var(--ink); }
  .fbtn.is-on { color: var(--paper); background: var(--deep); border-color: var(--deep); }

  .list { display: grid; gap: 1rem; }
  .item { background: #fff; border: 1px solid var(--rule); padding: 1.4rem 1.5rem; }
  .item.done { opacity: .55; }
  .ihead { display: flex; flex-wrap: wrap; align-items: baseline; gap: .7rem; margin-bottom: .8rem; }
  .tag {
    font-size: .74rem; font-weight: 700; letter-spacing: .08em; padding: .2rem .6rem;
    background: var(--paper-2); color: var(--deep);
  }
  .tag.research { background: #efeae2; }
  .iname { font-weight: 700; font-size: 1.05rem; }
  .idate { color: var(--muted); font-size: .84rem; margin-left: auto; }
  .icontact { font-size: .92rem; margin-bottom: .9rem; }
  .icontact a { color: var(--deep-2); }
  .imsg { white-space: pre-wrap; font-size: .97rem; line-height: 1.8; color: var(--ink-2); }
  .iact { display: flex; gap: .5rem; margin-top: 1.2rem; padding-top: 1rem; border-top: 1px solid var(--rule); }
  .iact button {
    appearance: none; background: none; cursor: pointer; font-family: inherit;
    font-size: .84rem; color: var(--muted); border: 1px solid var(--rule-2); padding: .35rem .85rem;
  }
  .iact button:hover { color: var(--ink); border-color: var(--ink); }
  .iact button.danger:hover { color: #9a3412; border-color: #9a3412; }
  .notice {
    display: flex; flex-wrap: wrap; align-items: center; gap: .8rem;
    margin: 0 0 1.4rem; padding: .95rem 1.1rem;
    background: #fdf6e6; border: 1px solid #e6d6a8; border-radius: 2px;
  }
  .notice p { margin: 0; flex: 1 1 22rem; font-size: .95rem; line-height: 1.7; }
  .notice button { flex: none; }
  .tag.other { background: #eceae6; color: #6b7580; }
</style>

<script>
  import { auth, db } from '../lib/firebase.js';
  import {
    signInWithEmailAndPassword, createUserWithEmailAndPassword,
    sendPasswordResetEmail, sendEmailVerification, deleteUser, signOut,
    onAuthStateChanged,
  } from 'firebase/auth';
  import {
    collection, query, orderBy, getDocs, doc, getDoc, updateDoc, deleteDoc,
  } from 'firebase/firestore';

  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const loginSec = $('#login') as HTMLElement;
  const inboxSec = $('#inbox') as HTMLElement;
  const form = $('#loginForm') as HTMLFormElement;
  const out = form.querySelector<HTMLParagraphElement>('.result')!;
  const listEl = $('#list') as HTMLElement;

  let rows: any[] = [];
  let filter = 'all';

  const fmt = (ts: any) => {
    if (!ts?.toDate) return '';
    const d = ts.toDate();
    return `${d.getFullYear()}. ${d.getMonth() + 1}. ${d.getDate()}. ` +
      `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  };
  const esc = (s: string) =>
    String(s).replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  // 문의 종류는 Firestore 값을 그대로 쓰지 않고 정해진 표기로만 바꾼다.
  // 규칙에서 type 을 검증하지만, 화면에 넣는 값은 여기서 한 번 더 좁힌다.
  const TYPES: Record<string, { cls: string; label: string }> = {
    research: { cls: 'research', label: '연구' },
    patient:  { cls: 'patient',  label: '환자·보호자' },
  };

  // 화면에 그려진 순서대로의 목록. 클릭 처리에서 인덱스로 되찾는다.
  let shownRows: any[] = [];

  function render() {
    const shown = rows.filter((r) =>
      filter === 'all' ? true : filter === 'new' ? r.status !== 'done' : r.type === filter);
    shownRows = shown;

    $('#stat').textContent = `전체 ${rows.length}건 · 미확인 ${rows.filter((r) => r.status !== 'done').length}건`;

    if (!shown.length) { listEl.innerHTML = '<p class="muted">해당하는 문의가 없습니다.</p>'; return; }

    listEl.innerHTML = shown.map((r, i) => `
      <article class="item ${r.status === 'done' ? 'done' : ''}" data-idx="${i}">
        <div class="ihead">
          <span class="tag ${(TYPES[r.type] || { cls: 'other' }).cls}">${
            (TYPES[r.type] || { label: '기타' }).label}</span>
          <span class="iname">${esc(r.name)}</span>
          <span class="idate">${fmt(r.createdAt)}</span>
        </div>
        <p class="icontact">${
          /^[^@\s]+@[^@\s]+$/.test(r.contact)
            ? `<a href="mailto:${esc(r.contact)}">${esc(r.contact)}</a>`
            : esc(r.contact)
        }</p>
        <div class="imsg">${esc(r.message)}</div>
        <div class="iact">
          <button data-act="toggle">${r.status === 'done' ? '미확인으로' : '처리 완료'}</button>
          <button data-act="delete" class="danger">삭제</button>
        </div>
      </article>`).join('');
  }

  async function load() {
    listEl.innerHTML = '<p class="muted">불러오는 중…</p>';
    try {
      const snap = await getDocs(query(collection(db, 'submissions'), orderBy('createdAt', 'desc')));
      rows = snap.docs.map((d) => ({ id: d.id, ...(d.data() as any) }));
      render();
    } catch (e) {
      console.error(e);
      listEl.innerHTML =
        '<p class="result err">문의를 불러오지 못했습니다. ' +
        '관리자로 등록된 계정인지, 그리고 이메일 인증을 마쳤는지 확인해 주십시오.</p>';
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.fbtn').forEach((b) => {
    b.addEventListener('click', () => {
      filter = b.dataset.f!;
      document.querySelectorAll('.fbtn').forEach((x) => x.classList.toggle('is-on', x === b));
      render();
    });
  });

  listEl.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-act]');
    if (!btn) return;
    const idx = Number(btn.closest<HTMLElement>('.item')!.dataset.idx);
    const row = shownRows[idx];
    if (!row) return;
    const id: string = row.id;
    // 자동 생성 ID(영숫자 20자)가 아니면 손대지 않는다.
    // 규칙을 우회해 직접 만든 문서일 수 있다.
    if (!/^[A-Za-z0-9]{20}$/.test(id)) {
      alert('문서 식별자 형식이 올바르지 않습니다. 이 문의는 화면에서 처리할 수 없습니다.');
      return;
    }
    try {
      if (btn.dataset.act === 'toggle') {
        const next = row.status === 'done' ? 'new' : 'done';
        await updateDoc(doc(db, 'submissions', id), { status: next });
        row.status = next; render();
      } else {
        if (!confirm('이 문의를 삭제할까요? 되돌릴 수 없습니다.')) return;
        await deleteDoc(doc(db, 'submissions', id));
        rows = rows.filter((r) => r.id !== id); render();
      }
    } catch (err) { console.error(err); alert('처리하지 못했습니다.'); }
  });

  // 로그인 <-> 가입 전환
  let mode = 'login';
  const btn = $('#mainBtn') as HTMLButtonElement;
  const lead = $('#lead') as HTMLElement;
  const altText = $('#altText') as HTMLElement;
  const pwhint = $('#pwhint') as HTMLElement;
  const pwInput = form.querySelector<HTMLInputElement>('[name=password]')!;

  function setMode(m: string) {
    mode = m;
    const signup = m === 'signup';
    btn.textContent = signup ? '계정 만들기' : '로그인';
    lead.textContent = signup
      ? '명단에 등록된 이메일로만 계정을 만들 수 있습니다. 비밀번호는 본인만 아는 것으로 정하세요.'
      : '등록된 관리자만 문의 내역을 볼 수 있습니다.';
    altText.innerHTML = signup
      ? '이미 계정이 있으신가요? <button type="button" class="linkbtn" data-toggle>로그인</button>'
      : '처음 오셨나요? <button type="button" class="linkbtn" data-toggle>계정 만들기</button>';
    pwhint.hidden = !signup;
    pwInput.autocomplete = signup ? 'new-password' : 'current-password';
    out.className = 'result'; out.textContent = '';
  }
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-toggle]');
    if (b) setMode(mode === 'signup' ? 'login' : 'signup');
  });

  // 비밀번호 재설정
  $('#reset').addEventListener('click', async () => {
    const email = String(new FormData(form).get('email') || '').trim();
    out.className = 'result';
    if (!email) { out.className = 'result err'; out.textContent = '이메일을 먼저 입력해 주십시오.'; return; }
    try {
      await sendPasswordResetEmail(auth, email);
      out.className = 'result ok';
      out.textContent = '재설정 메일을 보냈습니다. 받은편지함을 확인해 주십시오.';
    } catch {
      out.className = 'result err';
      out.textContent = '메일을 보내지 못했습니다. 이메일 주소를 확인해 주십시오.';
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    out.className = 'result'; out.textContent = '';
    const fd = new FormData(form);
    const email = String(fd.get('email') || '').trim();
    const pw = String(fd.get('password') || '');
    const label = btn.textContent;
    btn.disabled = true;
    btn.textContent = mode === 'signup' ? '만드는 중…' : '확인 중…';
    try {
      if (mode === 'signup') {
        const cred = await createUserWithEmailAndPassword(auth, email, pw);
        let ok = false;
        try {
          const s = await getDoc(doc(db, 'allowedUsers', email.toLowerCase()));
          ok = s.exists() && s.data()?.role === 'admin';
        } catch { ok = false; }
        if (!ok) {
          try { await deleteUser(cred.user); } catch { await signOut(auth); }
          out.className = 'result err';
          out.textContent = '관리자 명단에 없는 이메일입니다. 기존 관리자에게 등록을 요청해 주십시오.';
        } else {
          // 화이트리스트에 있는 계정만 인증 메일을 보낸다
          try { await sendEmailVerification(cred.user); } catch (e) { console.warn(e); }
        }
      } else {
        await signInWithEmailAndPassword(auth, email, pw);
      }
    } catch (err: any) {
      out.className = 'result err';
      const code = err?.code || '';
      out.textContent =
        code === 'auth/email-already-in-use' ? '이미 계정이 있는 이메일입니다. 로그인해 주십시오.'
        : code === 'auth/weak-password'      ? '비밀번호는 6자 이상이어야 합니다.'
        : code === 'auth/invalid-email'      ? '이메일 주소 형식이 올바르지 않습니다.'
        : mode === 'signup'                  ? '계정을 만들지 못했습니다.'
        :                                      '이메일 또는 비밀번호가 맞지 않습니다.';
    } finally {
      btn.disabled = false;
      btn.textContent = label || '로그인';
    }
  });

  $('#logout').addEventListener('click', () => signOut(auth));

  $('#resendVerify').addEventListener('click', async () => {
    const msg = $('#verifyMsg') as HTMLElement;
    const u = auth.currentUser;
    if (!u) return;
    msg.textContent = '보내는 중…';
    try {
      await sendEmailVerification(u);
      msg.textContent = '보냈습니다. 받은 편지함을 확인해 주십시오.';
    } catch (e) {
      console.error(e);
      msg.textContent = '보내지 못했습니다. 잠시 뒤 다시 시도해 주십시오.';
    }
  });

  onAuthStateChanged(auth, async (user) => {
    // 익명 사용자(문의 제출자)는 관리자가 아니다
    if (!user || !user.email) {
      loginSec.hidden = false; inboxSec.hidden = true; return;
    }
    // 화이트리스트 확인
    let ok = false;
    try {
      const s = await getDoc(doc(db, 'allowedUsers', user.email.toLowerCase()));
      ok = s.exists() && s.data()?.role === 'admin';
    } catch { ok = false; }

    if (!ok) {
      await signOut(auth);
      loginSec.hidden = false; inboxSec.hidden = true;
      out.className = 'result err';
      out.textContent = '관리자 명단에 없는 계정입니다. 기존 관리자에게 등록을 요청해 주십시오.';
      return;
    }
    $('#who').textContent = user.email;
    loginSec.hidden = true; inboxSec.hidden = false;

    // 이메일 인증 여부를 알린다. 지금은 막지 않는다 —
    // 실제 차단은 Firestore 규칙에서 하며, 규칙을 올리기 전에
    // 기존 관리자가 인증을 마칠 시간을 준다.
    try { await user.reload(); } catch { /* 무시 */ }
    ($('#verifyBanner') as HTMLElement).hidden = !!auth.currentUser?.emailVerified;

    load();
  });
</script>
