rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// Korea ALD — Firestore 보안 규칙
//
// 이 사이트는 공개 저장소에 있고 Firebase config도 공개됩니다.
// 따라서 데이터를 지키는 것은 오직 이 규칙입니다.
//
// 설계 원칙
//   1. 기본은 전면 차단. 필요한 것만 명시적으로 허용한다.
//   2. 문의는 누구나 제출할 수 있지만, 제출자 본인도 다시 읽을 수 없다.
//   3. 읽기·수정·삭제는 화이트리스트에 등록된 관리자만 가능하다.
//   4. 관리자 목록(allowedUsers)은 클라이언트에서 절대 쓸 수 없다.
//      관리자 추가는 Firebase 콘솔에서만 한다.
//
// 콘솔 적용 경로: Firestore Database → 규칙 탭 → 붙여넣기 → 게시
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 ────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function hasEmail() {
      return request.auth != null && request.auth.token.email != null;
    }
    function emailKey() {
      return request.auth.token.email.lower();
    }
    function isWhitelisted() {
      return hasEmail()
        && exists(/databases/$(database)/documents/allowedUsers/$(emailKey()));
    }
    // 이메일/비밀번호 가입은 주소 소유를 증명하지 않는다. 화이트리스트가
    // 이메일 기준이므로, 아직 가입하지 않은 관리자 주소를 남이 먼저
    // 차지할 수 있다. 인증된 주소만 관리자로 인정해 그 경로를 막는다.
    //
    // ⚠ 적용 순서 — 기존 관리자가 모두 /admin 에서 이메일 인증을 마친 뒤에
    //    이 규칙을 게시할 것. 먼저 게시하면 문의함을 읽지 못한다.
    function isAdmin() {
      return isWhitelisted()
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/allowedUsers/$(emailKey())).data.role == 'admin';
    }
    function isServerTime(ts) {
      return ts == request.time;
    }

    // ── 문의 접수 ───────────────────────────────────────────────────────
    // create : 누구나 (익명 로그인 필요). 필드·타입·길이를 엄격히 검증한다.
    // read   : 관리자만. 제출자 본인도 되읽을 수 없다.
    match /submissions/{id} {

      allow create: if signedIn()
        // 문서 ID 는 SDK 가 자동 생성한 영숫자 20자만 허용한다.
        // 우리 폼은 addDoc 을 쓰므로 항상 이 형식이다. 직접 API 를 불러
        // ID 에 따옴표나 태그를 심는 경로를 여기서 막는다.
        && id.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(
             ['type', 'name', 'contact', 'message', 'createdAt', 'status'])
        && request.resource.data.keys().hasAll(
             ['type', 'name', 'contact', 'message', 'createdAt'])
        && request.resource.data.type in ['research', 'patient']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.contact is string
        && request.resource.data.contact.size() > 0
        && request.resource.data.contact.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && isServerTime(request.resource.data.createdAt)
        && (!('status' in request.resource.data.keys())
            || request.resource.data.status == 'new');

      allow read: if isAdmin();

      // 관리자는 처리 상태만 바꿀 수 있다. 내용 위변조는 불가.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'note'])
        && request.resource.data.status in ['new', 'reading', 'done'];

      allow delete: if isAdmin();
    }

    // ── 관리자 목록 ─────────────────────────────────────────────────────
    // 로그인한 사용자가 "내가 관리자인가"를 확인할 때 본인 문서만 읽는다.
    // 쓰기는 어떤 경우에도 불가 — Firebase 콘솔에서만 추가/삭제한다.
    match /allowedUsers/{email} {
      allow read: if hasEmail() && email == emailKey();
      allow write: if false;
    }

    // ── 그 외 전부 차단 ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
