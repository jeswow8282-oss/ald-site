rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// Korea ALD — Firestore 보안 규칙
//
// 이 사이트는 공개 저장소에 있고 Firebase config도 공개됩니다.
// 따라서 데이터를 지키는 것은 오직 이 규칙입니다.
//
// 설계 원칙
//   1. 기본은 전면 차단. 필요한 것만 명시적으로 허용한다.
//   2. 문의는 누구나 제출할 수 있지만, 제출자 본인도 다시 읽을 수 없다.
//   3. 읽기·수정·삭제는 화이트리스트에 등록된 관리자만 가능하다.
//   4. 관리자 목록(allowedUsers)은 클라이언트에서 절대 쓸 수 없다.
//      관리자 추가는 Firebase 콘솔에서만 한다.
//
// 콘솔 적용 경로: Firestore Database → 규칙 탭 → 붙여넣기 → 게시
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 ────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function hasEmail() {
      return request.auth != null && request.auth.token.email != null;
    }
    function emailKey() {
      return request.auth.token.email.lower();
    }
    function isWhitelisted() {
      return hasEmail()
        && exists(/databases/$(database)/documents/allowedUsers/$(emailKey()));
    }
    // 이메일/비밀번호 가입은 주소 소유를 증명하지 않는다. 화이트리스트가
    // 이메일 기준이므로, 아직 가입하지 않은 관리자 주소를 남이 먼저
    // 차지할 수 있다. 인증된 주소만 관리자로 인정해 그 경로를 막는다.
    //
    // ⚠ 적용 순서 — 기존 관리자가 모두 /admin 에서 이메일 인증을 마친 뒤에
    //    이 규칙을 게시할 것. 먼저 게시하면 문의함을 읽지 못한다.
    function isAdmin() {
      return isWhitelisted()
        // 이메일/비밀번호 가입은 주소 소유를 증명하지 않는다. 화이트리스트가
        // 이메일 기준이라, 아직 가입하지 않은 관리자 주소를 남이 먼저
        // 차지할 수 있다. 인증된 주소만 관리자로 인정해 그 경로를 막는다.
        // 2026-10-09 관리자 전원 인증 완료를 확인하고 활성화했다.
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/allowedUsers/$(emailKey())).data.role == 'admin';
    }
    function isServerTime(ts) {
      return ts == request.time;
    }

    // ── 문의 접수 ───────────────────────────────────────────────────────
    // create : 누구나 (익명 로그인 필요). 필드·타입·길이를 엄격히 검증한다.
    // read   : 관리자만. 제출자 본인도 되읽을 수 없다.
    match /submissions/{id} {

      // 연락처는 두 가지 형식을 모두 받는다.
      //  새 형식 : prefer(email|phone) + 그 방법에 맞는 연락처
      //  예전 형식: contact 한 칸
      // 규칙을 게시하는 시점과 페이지가 갱신되는 시점이 어긋날 수 있어,
      // 캐시된 예전 페이지에서 온 문의도 잃지 않도록 둘 다 허용한다.
      function newShape() {
        return 'prefer' in request.resource.data.keys()
          && request.resource.data.prefer in ['email', 'phone']
          && request.resource.data.email is string && request.resource.data.email.size() <= 200
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
          && (request.resource.data.prefer != 'email'
              || request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))
          && (request.resource.data.prefer != 'phone'
              || (request.resource.data.phone.size() >= 9
                  && request.resource.data.phone.matches('^[0-9+() -]+$')));
      }
      function legacyShape() {
        return 'contact' in request.resource.data.keys()
          && request.resource.data.contact is string
          && request.resource.data.contact.size() > 0
          && request.resource.data.contact.size() <= 200;
      }

      allow create: if signedIn()
        // 문서 ID 는 SDK 가 자동 생성한 영숫자 20자만 허용한다.
        // 우리 폼은 addDoc 을 쓰므로 항상 이 형식이다. 직접 API 를 불러
        // ID 에 따옴표나 태그를 심는 경로를 여기서 막는다.
        && id.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(
             ['type', 'name', 'email', 'phone', 'prefer', 'contact',
              'message', 'createdAt', 'status'])
        && request.resource.data.keys().hasAll(['type', 'name', 'message', 'createdAt'])
        && request.resource.data.type in ['research', 'patient']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && (newShape() || legacyShape())
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && isServerTime(request.resource.data.createdAt)
        && (!('status' in request.resource.data.keys()) || request.resource.data.status == 'new');

      allow read: if isAdmin();

      // 관리자는 처리 상태만 바꿀 수 있다. 내용 위변조는 불가.
      // 관리자는 처리 상태와 답글만 쓸 수 있다. 문의 내용 자체는 못 고친다.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'note', 'reply', 'repliedAt', 'notified'])
        // 실제로 쓰는 값은 두 개뿐이다. 'reading' 같은 중간값을 열어두면
        // 집계 기준이 갈린다 — 개발부 현황판은 status != 'done' 으로,
        // 관리자 화면도 같은 기준으로 센다. 값을 둘로 못박아 어긋날 여지를 없앤다.
        && request.resource.data.status in ['new', 'done']
        && (!('reply' in request.resource.data.keys())
            || (request.resource.data.reply is string
                && request.resource.data.reply.size() <= 5000))
        && (!('notified' in request.resource.data.keys())
            || request.resource.data.notified in ['sent', 'manual', 'none']);

      allow delete: if isAdmin();
    }

    // ── 답변 메일 발송 큐 ───────────────────────────────────────────────
    // Firebase 'Trigger Email' 확장이 이 컬렉션을 보고 메일을 보낸다.
    // 확장은 서버 권한으로 돌기 때문에 이 규칙의 영향을 받지 않는다.
    // 클라이언트 쪽에서는 관리자만 넣을 수 있고, 아무도 읽지 못한다.
    match /mail/{id} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['to', 'message'])
        && request.resource.data.to is list
        && request.resource.data.to.size() == 1
        && request.resource.data.message.subject is string
        && request.resource.data.message.subject.size() <= 200
        && request.resource.data.message.text is string
        && request.resource.data.message.text.size() <= 20000;
      allow read, update, delete: if false;
    }

    // ── 관리자 목록 ─────────────────────────────────────────────────────
    // 로그인한 사용자가 "내가 관리자인가"를 확인할 때 본인 문서만 읽는다.
    // 쓰기는 어떤 경우에도 불가 — Firebase 콘솔에서만 추가/삭제한다.
    match /allowedUsers/{email} {
      allow read: if hasEmail() && email == emailKey();
      allow write: if false;
    }

    // ── 알림 받을 주소 ──────────────────────────────────────────────────
    // config/notify = { to: ["주소", ...] }
    // 새 문의 알림을 어디로 보낼지 적어두는 곳이다. 공개 저장소에 주소를
    // 적지 않으려고 여기에 둔다. 함수는 서버 권한으로 읽으므로 이 규칙과
    // 무관하고, 클라이언트에서는 아무도 읽거나 쓰지 못한다.
    match /config/{doc} {
      allow read, write: if false;
    }

    // ── 그 외 전부 차단 ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
